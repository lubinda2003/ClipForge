# GEMINI_API_KEY: Required for Gemini AI API calls (Research, Strategy, Scripting, Scene Planning).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_DATA_API: For legitimate public YouTube metadata research (search, public metrics)
YOUTUBE_API_KEY=""

# STOCK VIDEO APIS: For B-roll video search and asset retrieval
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# PIPER TTS: Local fast neural text-to-speech configuration
PIPER_BIN_PATH="piper"
PIPER_DEFAULT_MODEL="en_US-lessac-medium"
PIPER_MODELS_DIR="./models/piper"

# CLOUDFLARE R2 STORAGE: Reusable audio assets, inputs, and final rendered outputs
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_INPUTS="clipforge-inputs"
R2_BUCKET_ASSETS="clipforge-assets"
R2_BUCKET_OUTPUTS="clipforge-outputs"

# SYSTEM & CACHE CONFIGURATION
CLIPFORGE_CACHE_DIR="./.cache/clipforge"
CLIPFORGE_OUTPUT_DIR="./dist/outputs"
CLIPFORGE_LOG_LEVEL="info"

